<!doctype html><html lang="ro"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><link rel="stylesheet" href="/style.css"><title>Dashboard</title></head><body><header><b>DIICOT Reports</b><span><%= user.username %> · <b><%= user.rank.name %></b> · <a href="/logout">Ieșire</a></span></header><main class="wrap"><div class="grid"><a class="card" href="/new/raport"><h3>Raport nou</h3></a><a class="card" href="/new/razie"><h3>Razie nouă</h3></a><a class="card" href="/new/antrenament"><h3>Antrenament</h3></a><% if(user.rank.leadership){ %><a class="card gold" href="/leadership"><h3>Panou Conducere</h3></a><% } %></div><section class="card"><h2>Rapoartele mele</h2><table><tr><th>Tip</th><th>Titlu</th><th>Status</th><th>Data</th></tr><% reports.forEach(r=>{ %><tr><td><%= r.type %></td><td><%= r.title %></td><td><%= r.status %></td><td><%= r.created_at %></td></tr><% }) %></table></section></main></body></html>
