<!doctype html><html lang="ro"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><link rel="stylesheet" href="/style.css"><title>Conducere</title></head><body><header><b>Panou Conducere</b><a href="/dashboard">Dashboard</a></header><main class="wrap"><section class="card"><table><tr><th>Membru</th><th>Grad</th><th>Tip</th><th>Titlu</th><th>Status</th><th>Acțiune</th></tr><% reports.forEach(r=>{ %><tr><td><%= r.username %></td><td><%= r.rank_name %></td><td><%= r.type %></td><td><%= r.title %></td><td><%= r.status %></td><td><form method="post" action="/leadership/<%= r.id %>/status"><select name="status"><option>În așteptare</option><option>Aprobat</option><option>Respins</option></select><button>Salvează</button></form></td></tr><% }) %></table></section></main></body></html>
